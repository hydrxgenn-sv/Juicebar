<Project Sdk="Microsoft.NET.Sdk">

  <!-- Cross-platform core: model, HID access, battery sources, system monitor, settings and history. No UI. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Juicebar.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HidSharp" Version="2.1.0" />
    <!-- Windows only: reads LibreHardwareMonitor / ACPI sensors through WMI -->
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

</Project>
